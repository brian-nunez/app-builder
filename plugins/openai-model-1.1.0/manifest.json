{
  "protocol": "workflow.plugin/v1",
  "name": "community.openai-model",
  "version": "1.1.0",
  "title": "OpenAI-compatible model",
  "description": "Provide a chat model through the standard model resource contract.",
  "category": "AI resources",
  "kind": "resource",
  "configSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "default": "gpt-4.1-mini"
      },
      "base_url": {
        "type": "string",
        "default": "https://api.openai.com/v1"
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 0.2
      }
    },
    "required": [
      "model",
      "base_url",
      "temperature"
    ],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "api_key",
      "title": "Api Key",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "model",
      "title": "Model ID",
      "kind": "data",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "required": false,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "model",
      "title": "Model",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": true,
      "sensitive": true,
      "resourceType": "ai.chat-model/v1"
    }
  ],
  "permissions": [
    "network.http"
  ],
  "logFields": [],
  "metrics": [],
