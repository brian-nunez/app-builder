{
  "protocol": "workflow.plugin/v1",
  "name": "community.langchain-agent",
  "version": "1.2.0",
  "title": "LangChain agent",
  "description": "Compose a model, optional memory, and tools into a LangChain create_agent invocation.",
  "category": "AI",
  "kind": "action",
  "configSchema": {
    "type": "object",
    "properties": {
      "system_prompt": {
        "type": "string",
        "title": "System prompt",
        "description": "Base instructions used when the system prompt input is not connected.",
        "default": "You are a helpful assistant."
      },
      "thread_id": {
        "type": "string",
        "title": "Default thread ID",
        "description": "Stable conversation ID. Leave blank to use the run ID.",
        "default": ""
      },
      "recursion_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "title": "Recursion limit",
        "description": "Maximum agent graph steps allowed for one invocation.",
        "default": 25
      }
    },
    "required": [
      "system_prompt",
      "thread_id",
      "recursion_limit"
    ],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "prompt",
      "title": "Prompt",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "model",
      "title": "Model",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": true,
      "sensitive": true,
      "resourceType": "ai.chat-model/v1"
    },
    {
      "name": "memory",
      "title": "Memory",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": false,
      "sensitive": true,
      "resourceType": "memory.checkpointer/v1"
    },
    {
      "name": "tools",
      "title": "Tools",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": false,
      "sensitive": true,
      "resourceType": "ai.tools/v1",
      "multiple": true
    },
    {
      "name": "system_prompt",
      "title": "System prompt",
      "kind": "data",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "required": false,
      "sensitive": true
    },
    {
      "name": "thread_id",
      "title": "Thread ID",
      "kind": "data",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "required": false,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "response",
      "title": "Response",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "tool_calls",
      "title": "Tool calls",
      "kind": "data",
      "schema": {
        "type": "integer"
      },
      "required": true,
      "sensitive": false
    }
  ],
  "permissions": [],
  "logFields": [
    "message_count"
  ],
  "metrics": [
    {
      "name": "agent.messages",
      "kind": "counter",
      "unit": "{message}",
      "description": "Messages produced or consumed by an agent invocation"
    }
  ],
  "digest": "5bc62f87885991eef8cc0649d8e9d14f6aeed7ece617f90b842f8556b4376613"
}
