      "required": false,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "tools",
      "title": "Tools",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": true,
      "sensitive": true,
      "resourceType": "ai.tools/v1"
    }
  ],
  "permissions": [
    "network.http"
  ],
  "logFields": [],
  "metrics": [],
