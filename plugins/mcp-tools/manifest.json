{
  "protocol": "workflow.plugin/v1",
  "name": "community.mcp-tools",
  "version": "1.0.0",
  "title": "MCP tools",
  "description": "Provide tools from an approved streamable HTTP MCP server.",
  "category": "AI resources",
  "kind": "resource",
  "configSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "MCP server URL",
        "description": "Streamable HTTP endpoint for the MCP server.",
        "default": "https://mcp.internal/mcp"
      },
      "server_name": {
        "type": "string",
        "title": "Server name",
        "description": "Short label used to namespace tools from this server.",
        "default": "tools"
      }
    },
    "required": [
      "url",
      "server_name"
    ],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "token",
      "title": "Token",
      "kind": "data",
      "schema": {
        "type": "string"
