{
  "protocol": "workflow.plugin/v1",
  "name": "community.postgres-memory",
  "version": "1.0.0",
  "title": "PostgreSQL memory",
  "description": "Provide an agent checkpointer using a separate, explicitly connected PostgreSQL database.",
  "category": "AI resources",
  "kind": "resource",
  "configSchema": {
    "type": "object",
    "properties": {
      "namespace": {
        "type": "string",
        "title": "Memory namespace",
        "description": "Logical namespace that separates checkpoint conversations.",
        "default": "default"
      },
      "initialize": {
        "type": "boolean",
        "title": "Initialize tables",
        "description": "Create checkpoint tables when the resource opens.",
        "default": false
      },
      "sslmode": {
        "type": "string",
        "enum": [
          "verify-full",
          "verify-ca",
          "require",
          "disable"
        ],
        "title": "TLS mode",
        "description": "PostgreSQL sslmode used for the connection.",
        "default": "verify-full"
      }
    },
    "required": [
      "namespace",
      "initialize",
      "sslmode"
    ],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "host",
      "title": "Host",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "port",
      "title": "Port",
      "kind": "data",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "required": false,
      "sensitive": true
    },
    {
      "name": "database",
      "title": "Database",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "username",
      "title": "Username",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    },
    {
      "name": "password",
      "title": "Password",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "memory",
      "title": "Memory",
      "kind": "resource",
      "schema": {
        "type": "object"
      },
      "required": true,
      "sensitive": true,
      "resourceType": "memory.checkpointer/v1"
    }
  ],
  "permissions": [
    "network.postgres"
  ],
  "logFields": [],
  "metrics": [],
  "digest": "1d87d05a9ec2f9093d00d21670acc41d81bdfa0a4a22d7e1ef6d851f3af8ad41"
}
