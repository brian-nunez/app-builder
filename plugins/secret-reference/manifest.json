        "title": "Environment variable",
        "description": "Name of an allowlisted variable available to the worker.",
        "default": "PLUGIN_SECRET_SERVICE_TOKEN"
      }
    },
    "required": [
      "variable"
    ],
    "additionalProperties": false
  },
  "inputs": [],
  "outputs": [
    {
      "name": "value",
      "title": "Value",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": true,
      "sensitive": true
    }
  ],
  "permissions": [
    "secrets.environment"
  ],
  "logFields": [],
