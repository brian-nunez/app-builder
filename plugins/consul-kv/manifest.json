{
  "protocol": "workflow.plugin/v1",
  "name": "community.consul-kv",
  "version": "1.0.0",
  "title": "Consul key/value",
  "description": "Resolve a configuration key from an explicitly configured Consul service.",
  "category": "Configuration",
  "kind": "resource",
  "configSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Consul URL",
        "description": "Base URL of the Consul HTTP API.",
        "default": "https://consul.internal"
      },
      "key": {
        "type": "string",
        "title": "Key path",
        "description": "Consul KV path to read.",
        "default": "services/app/config"
      },
      "parse_json": {
        "type": "boolean",
        "title": "Parse JSON",
        "description": "Decode the stored value as JSON instead of returning text.",
        "default": false
      }
    },
    "required": [
      "url",
      "key",
      "parse_json"
    ],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "token",
      "title": "Token",
      "kind": "data",
      "schema": {
        "type": "string"
      },
      "required": false,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "value",
      "title": "Value",
      "kind": "data",
      "schema": {},
      "required": true,
      "sensitive": true
    }
  ],
  "permissions": [
    "network.http"
  ],
  "logFields": [],
  "metrics": [],
  "digest": "ac0177a1a7edaab6cb73a477efad3d450d1307c2a1c248e19d3f7f8b961b34ba"
}
