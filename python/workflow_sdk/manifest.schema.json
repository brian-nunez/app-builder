{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow:plugin:manifest:v1",
  "title": "Workflow plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "name",
    "version",
    "title",
    "description",
    "category",
    "kind",
    "configSchema",
    "inputs",
    "outputs",
    "permissions",
    "digest"
  ],
  "properties": {
    "protocol": {
      "const": "workflow.plugin/v1"
    },
    "name": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "enum": [
        "action",
        "resource",
        "trigger"
      ]
    },
    "configSchema": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "logFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "unit",
          "description"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "kind": {
            "enum": [
              "counter",
              "histogram"
            ]
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,100}$"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "kind",
        "schema"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "data",
            "resource"
          ]
        },
        "resourceType": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "schema": {
          "type": "object"
        },
        "multiple": {
          "type": "boolean"
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resource"
              }
            }
          },
          "then": {
            "required": [
              "resourceType"
            ]
          }
        }
      ]
    }
  }
}
